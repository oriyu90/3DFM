#!/usr/bin/env python3
"""3dfm CLI: thin REST client over the 3DFM local server (stdlib only).

Every command maps 1:1 to a REST call; the CLI never runs inference itself.
"""
from __future__ import annotations

import json
import os
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path


def _read_plist_data_dir() -> Path | None:
    """Read Swift @AppStorage customDataDir (stdlib only, never raises)."""
    try:
        import plistlib
        plist = Path.home() / "Library" / "Preferences" / "local.3dfm.app.plist"
        if not plist.is_file():
            return None
        with open(plist, "rb") as f:
            data = plistlib.load(f)
        raw = data.get("customDataDir", "") if isinstance(data, dict) else ""
        if not isinstance(raw, str) or not raw.strip():
            return None
        return Path(raw.strip()).expanduser()
    except Exception:
        return None


def _read_pointer_data_dir() -> Path | None:
    try:
        if sys.platform == "darwin":
            pointer = (Path.home() / "Library" / "Application Support"
                       / "3DFM.location")
        else:
            pointer = Path.home() / ".config" / "3DFM" / "data_dir.txt"
        if not pointer.is_file():
            return None
        raw = pointer.read_text(encoding="utf-8").strip()
        if not raw:
            return None
        first = raw.splitlines()[0].strip()
        return Path(first).expanduser() if first else None
    except Exception:
        return None


def data_dir() -> Path:
    o = os.environ.get("FM3D_DATA_DIR")
    if o and o.strip():
        return Path(o.strip()).expanduser()
    for reader in (_read_plist_data_dir, _read_pointer_data_dir):
        try:
            candidate = reader()
        except Exception:
            candidate = None
        if candidate is not None and str(candidate).strip():
            return candidate
    return Path.home() / "Library" / "Application Support" / "3DFM"


def token() -> str:
    p = data_dir() / "server.token"
    try:
        return p.read_text().strip()
    except OSError:
        sys.exit("server token not found (is the app running?)")


def find_port() -> int:
    if os.environ.get("FM3D_PORT"):
        return int(os.environ["FM3D_PORT"])
    for port in range(44931, 44941):
        try:
            with urllib.request.urlopen(
                    f"http://127.0.0.1:{port}/health", timeout=1) as r:
                if r.status == 200:
                    return port
        except OSError:
            continue
    sys.exit("3DFM server not reachable (launch the app or `3dfm serve`)")


class API:
    def __init__(self):
        self.base = f"http://127.0.0.1:{find_port()}"
        self.tok = token()

    def req(self, method: str, path: str, body=None, raw: bool = False):
        data = None
        headers = {"Authorization": f"Bearer {self.tok}"}
        if body is not None and not raw:
            data = json.dumps(body).encode()
            headers["Content-Type"] = "application/json"
        elif raw is not None and raw is not False and body is not None:
            data = body
        r = urllib.request.Request(self.base + path, data=data,
                                   headers=headers, method=method)
        try:
            with urllib.request.urlopen(r, timeout=120) as resp:
                out = resp.read()
                try:
                    return json.loads(out)
                except ValueError:
                    return out
        except urllib.error.HTTPError as e:
            try:
                detail = json.loads(e.read()).get("detail", e.reason)
            except ValueError:
                detail = e.reason
            sys.exit(f"error {e.code}: {detail}")

    def upload(self, path: str, spec: dict, files: list[str]):
        boundary = "3dfmboundary7d"
        buf = bytearray()
        part = (f"--{boundary}\r\nContent-Disposition: form-data; "
                f'name="spec"\r\n\r\n{json.dumps(spec)}\r\n').encode()
        buf += part
        for f in files:
            p = Path(f)
            buf += (f"--{boundary}\r\nContent-Disposition: form-data; "
                    f'name="images"; filename="{p.name}"\r\n'
                    "Content-Type: application/octet-stream\r\n\r\n").encode()
            buf += p.read_bytes() + b"\r\n"
        buf += f"--{boundary}--\r\n".encode()
        headers = {"Authorization": f"Bearer {self.tok}",
                   "Content-Type": f"multipart/form-data; boundary={boundary}"}
        r = urllib.request.Request(self.base + path, data=bytes(buf),
                                   headers=headers, method="POST")
        try:
            with urllib.request.urlopen(r, timeout=120) as resp:
                return json.loads(resp.read())
        except urllib.error.HTTPError as e:
            try:
                detail = json.loads(e.read()).get("detail", e.reason)
            except ValueError:
                detail = e.reason
            sys.exit(f"error {e.code}: {detail}")


def cmd_status(a: API, _):
