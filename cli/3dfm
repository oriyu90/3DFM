def cmd_file(a: API, args):
    """Download one artifact: 3dfm file <job-id> <path> [--out FILE]."""
    import argparse
    p = argparse.ArgumentParser(prog="3dfm file")
    p.add_argument("job_id")
    p.add_argument("path")
    p.add_argument("--out", default=None)
    ns = p.parse_args(args)
    # Raw download (bytes, not JSON).
    base = f"http://127.0.0.1:{find_port()}"
    url = (f"{base}/jobs/{urllib.parse.quote(ns.job_id)}/file"
           f"?path={urllib.parse.quote(ns.path)}")
    req = urllib.request.Request(
        url, headers={"Authorization": f"Bearer {token()}"}, method="GET")
    try:
        with urllib.request.urlopen(req, timeout=120) as resp:
            out = Path(ns.out) if ns.out else Path(Path(ns.path).name)
            # Stream to a temp sibling + atomic rename: artifacts can be
            # hundreds of MB; never hold them fully in RAM.
            tmp = out.parent / (out.name + f".part-{os.getpid()}")
            try:
                with open(tmp, "wb") as f:
                    while True:
                        chunk = resp.read(1024 * 1024)
                        if not chunk:
                            break
                        f.write(chunk)
                os.replace(tmp, out)
            except BaseException:
                try:
                    os.unlink(tmp)
                except OSError:
                    pass
                raise
    except urllib.error.HTTPError as e:
        try:
            detail = json.loads(e.read()).get("detail", e.reason)
        except ValueError:
            detail = e.reason
        sys.exit(f"error {e.code}: {detail}")
    print(str(out))


def cmd_open(a: API, args):
    if not args:
        sys.exit("usage: 3dfm open <job-id>")
    jid = args[0]
    a.req("GET", f"/jobs/{urllib.parse.quote(jid)}")  # 404 early if missing
    d = data_dir() / "jobs" / jid
    subprocess.run(["open", str(d)], check=False)


